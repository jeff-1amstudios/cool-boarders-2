# Installed/downloaded dependencies and tool build state (recipes stay tracked).
/tools/.venv/
/tools/cache/
/tools/tmp/
/tools/downloads/
/tools/ghidra/
/tools/ghidra-state/
/tools/vendor/
/tools/build/
/tools/toolchain/
/tools/compilers/
